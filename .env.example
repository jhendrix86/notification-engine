# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notifications

# Redis
REDIS_URL=redis://localhost:6379

# Email (SendGrid)
SENDGRID_API_KEY=
DEFAULT_EMAIL_FROM=notifications@company.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Slack
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#alerts

# Discord
DISCORD_WEBHOOK_URL=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# Escalation
ESCALATION_HOURS=24

# Digest
DIGEST_ENABLED=true
DIGEST_INTERVAL_HOURS=6

# Application
DEBUG=false

# Integration
GLOBAL_STATE_MANAGER_URL=http://localhost:8035
GOVERNANCE_ENGINE_URL=http://localhost:8033
